# 이 파일을 .env.local로 복사한 뒤 Supabase 대시보드 값으로 채운다.
# Project Settings > API (또는 Connect)에서 확인할 수 있다.
# .env.local은 .gitignore에 포함되어 GitHub에 올라가지 않는다.

# 브라우저에 노출되어도 되는 공개 값 (데이터 보호는 RLS가 담당)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# RLS를 무시하는 관리자 키. 이번 범위에서는 사용하지 않는다.
# 필요해지면 NEXT_PUBLIC_ 없이 서버 전용으로만 추가하고 절대 커밋하지 않는다.
# SUPABASE_SECRET_KEY=

# 결과지로 루틴 추천(/routine)에 쓰는 Gemini API 키. 서버 전용이라 NEXT_PUBLIC_를 붙이지 않는다.
# Google AI Studio(https://aistudio.google.com/apikey)에서 만든다. Vercel에는 Project Settings > Environment Variables에 넣는다.
GEMINI_API_KEY=
# 선택: 쓸 Gemini 모델 이름. 비워 두면 gemini-3.5-flash (PoC에서 정확도 100%로 검증한 모델)
# GEMINI_MODEL=
# 선택: 기본 모델이 바쁘거나(429·503) 25초 안에 답이 없을 때 쓸 모델. 비워 두면 gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=
